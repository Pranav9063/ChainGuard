# Dockerfile.chainguard
FROM golang:1.25 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Optimized build for static linking
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -ldflags="-s -w" -o hello-app .

# Final stage: Chainguard Static (No shell, no package manager, zero CVEs)
FROM cgr.dev/chainguard/static:latest
WORKDIR /app
COPY --from=builder /app/hello-app .

EXPOSE 8080
CMD ["./hello-app"]