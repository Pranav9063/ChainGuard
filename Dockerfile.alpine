# Dockerfile.alpine (Multi-stage with Alpine runtime)
FROM golang:1.25 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# Optimized build for static linking
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -ldflags="-s -w" -o hello-app .

# Final stage: Alpine (still has apk and /bin/sh)
FROM alpine:3.21
RUN adduser -D -u 65532 nonroot
WORKDIR /app
COPY --from=builder /app/hello-app .

USER nonroot
EXPOSE 8080
CMD ["./hello-app"]